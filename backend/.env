# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=samadhan
DB_PASSWORD=samadhan_secret
DB_NAME=samadhan_setu

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379


# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_very_long_random_string
JWT_EXPIRES_IN=7d

# ─── OTP (set MOCK_OTP=true to accept any 6-digit code) ───────
MOCK_OTP=true
# MSG91_AUTH_KEY=your_msg91_key_here
# MSG91_SENDER_ID=SMDHAN

# ─── Firebase Cloud Messaging ─────────────────────────────────
# FCM_SERVER_KEY=your_firebase_server_key_here

# ─── Media uploads ────────────────────────────────────────────
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=10

# ─── AI Routing & Semantic Pipeline ───────────────────────────
AI_EMBEDDING_MODE=transformers
# GEMINI_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here
